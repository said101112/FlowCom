# ---------------------------------------------------------------------------
# FlowCom - Backend
# Copier ce fichier vers .env : cp .env.example .env
# Ne JAMAIS committer le .env (il est déjà ignoré par .gitignore)
# ---------------------------------------------------------------------------

# --- Serveur ---
NODE_ENV=development
PORT=3000

# Origines autorisées par CORS, séparées par des virgules.
# En production : https://flowcom.example.com
CLIENT_ORIGIN=http://localhost:4200

# URL publique du backend, utilisée pour les liens d'email de vérification.
APP_URL=http://localhost:3000

# --- Base de données ---
MONGO_URL=mongodb://localhost:27017/flowcom

# --- Authentification ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-de-64-caracteres-minimum

# --- Email (SMTP) ---
# SMTP non configuré => les emails de vérification ne partent pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FlowCom <no-reply@flowcom.local>

# --- Suggestions IA (Groq / xAI compatible) ---
# Clé absente => les suggestions tombent sur des valeurs par défaut.
XAI_API_KEY=
XAI_BASE=https://api.groq.com/openai/v1

# --- Seed administrateur (utilisé par `npm run seed:admin`) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flowcom.local
ADMIN_PASSWORD=
ADMIN_PHONE=0000000000

# --- Logging ---
# error | warn | info | debug
LOG_LEVEL=info